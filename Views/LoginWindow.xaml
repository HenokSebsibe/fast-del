<Window x:Class="FoodyExpress.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodyExpress - Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid>
        <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Margin="40" Padding="30"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FoodyExpress" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                <TextBlock Text="Delivery Management System" FontSize="14" Foreground="{StaticResource TextColorLight}" HorizontalAlignment="Center" Margin="0,0,0,30" />
                
                <TextBlock Text="Username" Foreground="{StaticResource TextColor}" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtUsername" Height="35" Margin="0,0,0,15" />
                
                <TextBlock Text="Password" Foreground="{StaticResource TextColor}" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtPassword" Height="35" Margin="0,0,0,25" />
                
                <Button Content="LOGIN" Height="40" Click="LoginButton_Click" />
                
                <TextBlock x:Name="txtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
