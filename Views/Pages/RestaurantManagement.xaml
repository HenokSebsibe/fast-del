<UserControl x:Class="FoodyExpress.Views.Pages.RestaurantManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Restaurant Management" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtName" Width="150" Margin="0,0,20,0"/>
                
                <TextBlock Text="Phone:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtPhone" Width="120" Margin="0,0,20,0"/>
                
                <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtAddress" Width="150" Margin="0,0,20,0"/>

                <Button Content="Add Restaurant" Click="BtnAdd_Click" Padding="15,5" Width="120"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="DataGridRestaurants" AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding RestaurantID}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding RestaurantName}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
