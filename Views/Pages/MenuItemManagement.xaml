<UserControl x:Class="FoodyExpress.Views.Pages.MenuItemManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Menu Item Management" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Restaurant ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtRestaurantId" Width="50" Margin="0,0,20,0"/>

                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtName" Width="120" Margin="0,0,20,0"/>
                
                <TextBlock Text="Price:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtPrice" Width="80" Margin="0,0,20,0"/>

                <Button Content="Add Menu Item" Click="BtnAdd_Click" Padding="15,5" Width="140"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="DataGridMenuItems" AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding MenuItemID}" Width="50"/>
                <DataGridTextColumn Header="Restaurant ID" Binding="{Binding RestaurantID}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding ItemName}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
