<UserControl x:Class="FoodyExpress.Views.Pages.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Welcome to FoodyExpress Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>
            
            <WrapPanel>
                <!-- Summary Card 1 -->
                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Width="200" Height="100" Margin="0,0,20,20" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Total Orders" Foreground="{StaticResource TextColorLight}" FontSize="14"/>
                        <TextBlock x:Name="txtTotalOrders" Text="0" Foreground="{StaticResource PrimaryColor}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Summary Card 2 -->
                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Width="200" Height="100" Margin="0,0,20,20" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Active Menu Items" Foreground="{StaticResource TextColorLight}" FontSize="14"/>
                        <TextBlock x:Name="txtMenuCount" Text="0" Foreground="{StaticResource PrimaryColor}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
